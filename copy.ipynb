   "source": [
    "a = [[1, 2, 3], [4, 5, 6]]\n",
    "\n",
    "# Creating a shallow copy of the nested list 'original'\n",
    "b = copy.copy(a)\n",
    "\n",
    "# Modifying an element in the shallow-copied list\n",
    "b[0][0] = 99\n",
    "\n",
    "# Printing the original and shallow-copied lists  \n",
    "print(b)\n",
    "\n",
    "print(a)"
   ]
